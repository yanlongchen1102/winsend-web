{
  "name": "winsend-web",
  "private": true,
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/build-site.mjs --check",
    "check:copy": "python scripts/check-product-copy.py",
    "test": "node --test tests/*.test.mjs",
    "test:preview": "npm run build && node scripts/smoke-preview.mjs",
    "test:visual": "npm run build && node scripts/smoke-preview.mjs --visual",
    "build": "npm run build:site && npm run test && npm run build:css && npm run check:site",
    "build:css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --minify",
    "prepreview": "npm run build && node scripts/prepare-preview.mjs",
    "preview": "wrangler dev --local --assets .wrangler/preview-assets",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "predeploy:dry-run": "npm run build",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "wrangler": "4.124.0"
  }
}
